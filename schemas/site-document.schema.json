{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArkNetz site document (PROTOCOL.md §3.2)",
  "type": "object",
  "required": [
    "domain",
    "title",
    "blocks"
  ],
  "properties": {
    "domain": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "theme": {
      "type": "object"
    },
    "nav": {
      "type": "array"
    },
    "header": {
      "type": "array"
    },
    "footer": {
      "type": "array"
    },
    "blocks": {
      "type": "array"
    },
    "version": {
      "type": "string"
    },
    "updated": {
      "type": "integer"
    }
  }
}
