{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArkNetz feed pointer (PROTOCOL.md §3.7)",
  "type": "object",
  "required": [
    "domain",
    "post",
    "at"
  ],
  "properties": {
    "domain": {
      "type": "string"
    },
    "post": {
      "type": "string"
    },
    "at": {
      "type": "integer"
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    }
  }
}
